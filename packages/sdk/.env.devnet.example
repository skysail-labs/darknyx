# Devnet E2E test config. Copy to .env.devnet and fill in the blanks.
# .env.devnet is gitignored.

# ---- L1 (Solana devnet) RPC ----
# Use a dedicated devnet RPC for release/CVM work. Routine integration uses the
# pinned loopback Surfpool and does not read this file.
#
# SET BOTH. `SOLANA_RPC_URL` takes precedence where both are read, but some
# paths fall back to the `l1RpcUrl` snapshot baked into .devnet/e2e-config.json.
# Keeping only one current is how a rotated key goes unnoticed: the live file
# works, the other silently serves a revoked one.
#
# VERIFYING CREDENTIALS: probe with a real authenticated method such as
# `getSlot`; do not infer access from an unauthenticated health endpoint:
#   curl -s -X POST "$SOLANA_RPC_URL" \
#     -H 'content-type: application/json' \
#     -d '{"jsonrpc":"2.0","id":1,"method":"getSlot"}'
L1_RPC_URL=https://<your-devnet-rpc-provider>/<credential>
SOLANA_RPC_URL=https://<your-devnet-rpc-provider>/<credential>

# ---- Program id ----
# The deployed devnet vault. Every devnet test defaults to this and accepts
# VAULT_PROGRAM_ID as an override, which is how a separate deployment (a second
# foundation, an experimental build) is targeted without editing sources.
VAULT_PROGRAM_ID=C63vKvysCzX55PKraas4Wc22ijqjGJQdPC1mrzCFVWZx

# ---- Merkle shard count (optional) ----
# Leave UNSET unless you are deliberately founding a different K. devnet-setup
# adopts the shard count of the deployed VaultConfig when this is unset; a value
# that disagrees with the chain is treated as an operator error and refused.
# DARKNYX_NUM_TREES=4

# ---- Test fixture keypair paths (generated by scripts/setup-devnet.sh) ----
ADMIN_KEYPAIR=.devnet/keypairs/admin.json
TEE_AUTHORITY_KEYPAIR=.devnet/keypairs/tee_authority.json
ROOT_KEY_KEYPAIR=.devnet/keypairs/root_key.json
TRADER_KEYPAIR=.devnet/keypairs/trader.json

# ---- Test gates ----
# Each devnet suite is opt-in; all of them self-skip (and report GREEN) when
# their gate is unset, so set the one you actually mean to run.
# RUN_DEVNET_E2E=1      # devnet-setup: mints + vault + protocol config
# RUN_DEVNET_DW=1       # devnet-deposit-withdraw: deposit -> VALID_SPEND withdraw
# RUN_DEVNET_MERGE=1    # devnet-merge: 2 notes -> VALID_MERGE -> withdraw
# RUN_DEVNET_LEAF=1     # devnet-leaf-index: event-based leaf-index reads

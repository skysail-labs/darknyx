# packages/sdk/.env — test secrets/config (gitignored; copy to `.env` and fill).
# Loaded by tests/setup-env.ts before any test runs. Nothing here is needed for
# the `local` bucket; `devnet`/`cvm` buckets self-skip when their RUN_* flag is
# absent, so set only what the bucket you intend to run requires.

# ── Solana RPC ────────────────────────────────────────────────────────────
# A dedicated devnet RPC with the capacity and history methods required by the
# devnet+CVM release suite. Public devnet is not a reliable release gate.
# This replaces the old /tmp/darknyx.env + CLI-arg passing of credentials.
SOLANA_RPC_URL=https://<your-devnet-rpc-provider>/<credential>

# Development/CVM default: finalized upgraded Pyth Core push accounts through
# SOLANA_RPC_URL. No paid Pyth credential is needed.
DARKNYX_TEE_DEPLOYMENT_TIER=development
DARKNYX_TEE_ORACLE_MODE=pyth-solana-push-v1
# Mainnet low-latency mode only:
# DARKNYX_TEE_DEPLOYMENT_TIER=mainnet
# DARKNYX_TEE_ORACLE_MODE=pyth-router-quorum-v1
# DARKNYX_TEE_PYTH_API_KEY=<your-pyth-key>
# DARKNYX_TEE_HERMES_ENDPOINT=https://pyth.dourolabs.app/hermes

# ── CVM bucket (RUN_CVM_E2E=1) ───────────────────────────────────────────────
# The deployed Phala CVM's gateway, from `phala cvms list` / the deploy log.
#
# Since the T-03P RA-TLS cutover the enclave terminates TLS itself and :8080 is
# NO LONGER PUBLISHED — it returns HTTP 000, which reads like a dead enclave
# rather than a wrong URL. Use the dstack passthrough form: the trailing `s` on
# `-8443s` is what makes the gateway bridge raw TCP instead of terminating TLS
# (CLAUDE.md §3.4b).
#
# The node suffix (prod5 / prod7 / prod9 / ...) is assigned PER CVM. Probe for
# it; do not copy one from a doc.
DARKNYX_TEE_GATEWAY=https://<app_id>-8443s.dstack-pha-<node>.phala.network

# ── Run flags (set =1 to opt a bucket/file in) ──────────────────────────────
# devnet bucket:
# RUN_DEVNET_E2E=1     # devnet-setup (rebuild mints/ALT/config → .devnet/e2e-config.json)
# RUN_DEVNET_DW=1      # devnet-deposit-withdraw
# RUN_DEVNET_MERGE=1   # devnet-merge
# RUN_DEVNET_LEAF=1    # devnet-leaf-index
# cvm bucket:
# RUN_CVM_E2E=1        # cvm-settle-e2e, cvm-multimatch-settle, cvm-merge-then-order, cvm-api-surface

# ── Keypairs (relative to repo root; defaults shown) ────────────────────────
# ADMIN_KEYPAIR=.devnet/keypairs/admin.json
# FUNDER_KEYPAIR=~/.config/solana/id.json
# TEE_AUTHORITY_KEYPAIR=.devnet/keypairs/tee_authority.json
# ROOT_KEY_KEYPAIR=.devnet/keypairs/root_key.json

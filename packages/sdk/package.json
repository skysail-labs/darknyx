{
  "name": "@nyx/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Nyx dark pool TypeScript SDK — factory-function API, injectable providers, staged errors.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:local": "vitest run --project local",
    "test:devnet": "vitest run --project devnet",
    "test:cvm": "vitest run --project cvm",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "circom_tester": "0.0.24",
    "circomlibjs": "^0.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}

{
  "name": "@darknyx/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Darknyx dark pool TypeScript SDK — factory-function API, injectable providers, staged errors.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser-recovery": {
      "types": "./dist/browser-recovery.d.ts",
      "default": "./dist/browser-recovery.js"
    },
    "./browser-inventory-crypto": {
      "types": "./dist/browser-inventory-crypto.d.ts",
      "default": "./dist/browser-inventory-crypto.js"
    },
    "./merkle-root-ring": {
      "types": "./dist/zk/merkle-root-ring.d.ts",
      "default": "./dist/zk/merkle-root-ring.js"
    },
    "./browser-attestation": {
      "types": "./dist/browser-attestation.d.ts",
      "default": "./dist/browser-attestation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:local": "vitest run --project local",
    "test:devnet": "vitest run --project devnet",
    "test:cvm": "vitest run --project cvm",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@phala/dcap-qvl": "^0.3.9",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "circom_tester": "0.0.24",
    "circomlibjs": "^0.1.7",
    "tweetnacl": "1.0.3"
  },
  "optionalDependencies": {
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}

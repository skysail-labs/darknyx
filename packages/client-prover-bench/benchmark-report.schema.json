{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:darknyx:schema:client-prover-benchmark:v1",
  "title": "Darknyx client prover benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "host", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "backend": { "type": "string", "minLength": 1 },
    "mode": { "type": "string" },
    "host": {
      "type": "object",
      "required": ["recorded_at", "platform", "arch", "cpus"],
      "additionalProperties": true,
      "properties": {
        "recorded_at": { "type": "string", "format": "date-time" },
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "cpus": { "type": "integer", "minimum": 1 }
      }
    },
    "results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["artifacts"],
        "additionalProperties": true,
        "properties": {
          "artifacts": {
            "type": "object",
            "required": ["wasm", "zkey", "verification_key"],
            "additionalProperties": false,
            "properties": {
              "wasm": { "$ref": "#/$defs/artifact" },
              "zkey": { "$ref": "#/$defs/artifact" },
              "verification_key": { "$ref": "#/$defs/artifact" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

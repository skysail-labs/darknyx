{
  "name": "@nyx/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Nyx reference daemon — long-running client for market makers + funds. Wraps the SDK: order lifecycle, auto-merge, settlement reconciliation, local control API. Keys + proving stay on-device.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "nyx-daemon": "dist/bin/daemon.js",
    "nyx-keystore-init": "dist/bin/keystore-init.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin/daemon.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nyx/sdk": "0.1.0",
    "@phala/dcap-qvl": "^0.3.9",
    "@solana/web3.js": "^1.98.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}

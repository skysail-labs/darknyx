{
  // Typecheck-only config that INCLUDES tests.
  //
  // The build config deliberately excludes `tests/` — it emits declarations into
  // `dist/` and tests must not ship. The consequence was that test files were
  // typechecked by nothing: vitest strips types rather than checking them, and
  // no CI job ran `tsc` at all, so a type error could sit on main indefinitely
  // with every gate green (audit 2026-07-25 follow-up).
  //
  // `noEmit` + `composite: false` keep this purely a checker; it never writes
  // output and never participates in project references.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // `incremental` is inherited true from the root config; with an inherited
    // `outDir` that made this checker write a .tsbuildinfo INTO dist/, which is
    // build output it has no business touching. A checker must not emit.
    "incremental": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    // Widened to the repo root: the inherited `rootDir` would reject tests/ as
    // "not under rootDir", and some tests deep-import a sibling package's src.
    // Harmless because nothing is emitted.
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": ["src/**/*", "bin/**/*", "tests/**/*", "../sdk/types/**/*"]
}

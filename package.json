{
  "name": "darknyx",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving Solana dark pool: in-TEE matching/settlement (Phala CVM) + ZK note settlement",
  "workspaces": [
    "packages/*",
    "circuits"
  ],
  "scripts": {
    "build:circuits": "bash scripts/build-circuits.sh",
    "setup:ptau": "bash scripts/download-ptau.sh",
    "test:sdk": "npm -w @darknyx/sdk run test",
    "test:prover": "npm -w @darknyx/client-prover-bench run test",
    "bench:client-prover:node": "npm -w @darknyx/client-prover-bench run bench:node --",
    "bench:client-prover:browser": "npm -w @darknyx/client-prover-bench run bench:browser --",
    "bench:client-prover:native": "npm -w @darknyx/client-prover-bench run bench:native --",
    "check:brand": "bash scripts/check-brand-namespace.sh",
    "typecheck": "tsc -b packages",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\""
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@types/node": "^20.11.0",
    "circom_tester": "^0.0.24",
    "circomlib": "^2.0.5",
    "dotenv": "16.4.5",
    "prettier": "^3.2.5",
    "snarkjs": "^0.7.5",
    "ts-node": "^10.9.0",
    "tweetnacl": "1.0.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

# Solana keypairs (never commit)
*.json.key
*-keypair.json
tests/fixtures/wallets/*.json

# Devnet test fixtures (generated + funded locally; never committed)
.devnet/
!.devnet/README.md

# Circom build artifacts (generated — except committed zkeys)
# Do NOT ignore circuits/build/ at the directory level; git won't descend
# into an ignored directory to apply negation patterns.
circuits/build/**/*.r1cs
circuits/build/**/*.sym
circuits/build/**/*_js/
circuits/build/**/*.zkey
!circuits/build/**/circuit_final.zkey
circuits/**/*.r1cs
circuits/**/*.sym
circuits/**/*_js/

# Powers of Tau (large files, downloaded)
scripts/ptau/*.ptau

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

#agents
.agents/
.factory/
skills-lock.json



{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darknyx.org/schemas/privacy-domain-registry.v1.json",
  "title": "Darknyx Poseidon domain registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryStatus",
    "frozenOn",
    "lifecycleValues",
    "policy",
    "domains"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "registryStatus": {
      "enum": [
        "phase0-provisional",
        "authoritative"
      ]
    },
    "frozenOn": {
      "type": "string",
      "format": "date"
    },
    "lifecycleValues": {
      "type": "array",
      "const": [
        "active",
        "provisional",
        "retired"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainNumbersAreNeverReused",
        "sameArityMeaningChangeRequiresFreshDomain",
        "provisionalBecomesActiveOnlyInAtomicCutover",
        "retiredAssignmentsRemainReserved"
      ],
      "properties": {
        "domainNumbersAreNeverReused": {
          "const": true
        },
        "sameArityMeaningChangeRequiresFreshDomain": {
          "const": true
        },
        "provisionalBecomesActiveOnlyInAtomicCutover": {
          "const": true
        },
        "retiredAssignmentsRemainReserved": {
          "const": true
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "symbol",
        "arity",
        "lifecycle",
        "version",
        "meaning",
        "consumers"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "symbol": {
          "type": "string",
          "pattern": "^DOMAIN_[A-Z0-9_]+$"
        },
        "arity": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "provisional",
            "retired"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "supersededBy": {
          "type": "integer",
          "minimum": 0
        },
        "activationPhase": {
          "type": "integer",
          "minimum": 0
        },
        "retirementPhase": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
